{
  "name": "hajime-pro",
  "version": "1.0.14",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node src/app.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:vollablauf": "playwright test --config=playwright.vollablauf.config.js",
    "ci:lokal": "node scripts/ci-lokal.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e:sync": "playwright test --config=playwright.sync.config.js",
    "test:e2e:cluster": "playwright test -c playwright.cluster.config.js",
    "test:e2e:mobil": "playwright test -c playwright.mobil.config.js",
    "android:www": "node scripts/baue-android-www.mjs",
    "android:apk": "node scripts/baue-android-apk.mjs",
    "android:geraet": "node scripts/android-geraet.mjs",
    "android:schluessel": "node scripts/android-schluessel.mjs",
    "pg:start": "node scripts/lokale-pg.mjs start",
    "pg:stopp": "node scripts/lokale-pg.mjs stopp",
    "pg:status": "node scripts/lokale-pg.mjs status",
    "client:schluessel": "node scripts/client-schluessel.mjs",
    "client:signieren": "node scripts/signiere-client.mjs",
    "client:holen": "node scripts/hole-client-release.mjs",
    "desktop:start": "electron .",
    "desktop:icon": "node scripts/erzeuge-app-icon.mjs",
    "desktop:build": "electron-builder --config desktop/electron-builder.yml",
    "test:electron": "playwright test -c playwright.electron.config.js",
    "desktop:server:start": "electron desktop/server/main.js",
    "desktop:server:build": "electron-builder --config desktop/electron-builder.server.yml",
    "test:electron:server": "playwright test -c playwright.electron-server.config.js",
    "android:icon": "node scripts/erzeuge-android-icon.mjs"
  },
  "dependencies": {
    "@material-design-icons/font": "^0.14.15",
    "@pdf-lib/fontkit": "^1.1.1",
    "bonjour-service": "^1.4.4",
    "dotenv": "^18.0.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "express": "^5.2.1",
    "express-pouchdb": "^4.2.0",
    "express-rate-limit": "^8.7.1",
    "fabric": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "knex": "^3.1.0",
    "material-components-web": "^14.0.0",
    "multicast-dns": "^7.2.5",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.1",
    "pouchdb": "^9.0.0",
    "pouchdb-find": "^9.0.0",
    "pouchdb-node": "^9.0.0",
    "qrcode-generator": "^2.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
