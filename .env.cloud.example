# Cloud-Modus (BETRIEBSMODUS=cloud). Nach .env.cloud kopieren und ausfüllen — .env.* ist git-ignoriert.
PORT=3000

# Datenbank: Verbindungs-URL, z.B. Supabase "Connection string" (Transaction-Pooler, Port 6543).
DB_URL=postgresql://postgres.PROJEKT:PASSWORT@aws-0-REGION.pooler.supabase.com:6543/postgres
# TLS: no-verify (Standard bei DB_URL), true (mit Zertifikatsprüfung) oder false
#DB_SSL=no-verify
# Migrationen brauchen eine Direct-/Session-Verbindung (Supabase: Port 5432), nicht den Transaction-Pooler
#DB_URL_MIGRATION=postgresql://postgres.PROJEKT:PASSWORT@aws-0-REGION.pooler.supabase.com:5432/postgres
# Beim Start automatisch migrieren (Standard aus)
#DB_AUTO_MIGRATE=true
#DB_POOL_MAX=10

# Pflicht: geheimer Schlüssel für die Sitzungs-Tokens (JWT)
JWT_SECRET=

# Pflicht: öffentliche Adresse der Cloud (nur http/https, ohne Pfad) für die Links in Registrierungs-
# und Freischaltungs-Mails. Fehlt sie, ist die Registrierung abgeschaltet (503) – der Host-Header
# eines Requests wird in der Cloud nie für Mail-Links verwendet.
PUBLIC_BASE_URL=

# Erforderlich in der Cloud: Mailversand. Registrierung (Bestätigungslink) und Freischaltung (Link an die
# Vereins-Admins) laufen nur über Mails – ohne SMTP kommt niemand neu ins System. Ohne SMTP_HOST werden Mails
# nicht versendet; die Cloud loggt dann nur Empfänger und Betreff (keine Links).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Hajime Pro" <no-reply@example.org>

# Ratenbegrenzung von Registrierung, „Bestätigungsmail erneut senden“ und Login (in der Cloud standardmäßig an,
# zählt im Speicher je Instanz): je Absender (IPv6 je /64) 10 Registrierungen, 10 erneute Bestätigungsmails und
# 30 Logins je 10 Minuten; zusätzlich je E-Mail-Adresse 3 erneute Bestätigungsmails, je Adresse und Absender
# 10 Logins und je Adresse insgesamt 60 Logins je 10 Minuten (sonst 429). false schaltet sie ab.
#AUTH_RATENLIMIT_AKTIV=true
# Hinter einem eigenen Reverse-Proxy: Absender aus X-Forwarded-For (sonst teilen sich alle die Proxy-Adresse)
#LIVE_PROXY_VERTRAUEN=true
#LIVE_PROXY_HOPS=1

# Optional: festes Start-Passwort des automatisch angelegten Super-Admins
#SUPER_ADMIN_INITIAL_PASSWORD=

# Zwei-Faktor-Anmeldung (Authenticator-App) ist für Super-Admins in der Cloud Pflicht; false schaltet sie ab (nur Entwicklung)
#SUPER_ADMIN_2FA=false
# Ablage der Server-Sicherungen (Seite „Sicherung“, scripts/sicherung.mjs), Standard ./data/sicherungen
#SICHERUNG_VERZEICHNIS=/var/backups/hajime

# Aufbewahrung des Aktionsprotokolls in Tagen (Standard 365; ältere Einträge werden täglich gelöscht)
#PROTOKOLL_AUFBEWAHRUNG_TAGE=365

# Automatische Sicherung (täglich, Seite „Sicherung“): Uhrzeit (Berlin), Anzahl der behaltenen automatischen Sicherungen,
# AUTOMATISCH=false schaltet sie ab. Eine Kopie an anderem Ort: Verzeichnis (z. B. Netzlaufwerk) und/oder ein Befehl, der nach
# jeder Sicherung läuft (HAJIME_SICHERUNG_DATEI und HAJIME_SICHERUNG_NAME stehen in seiner Umgebung).
# Verschlüsselt jede Sicherung (AES-256-GCM): mindestens 20 Zeichen, zufällig (openssl rand -base64 32). Das Passwort zusätzlich im Passwort-
# Manager und ausgedruckt aufbewahren: ohne es sind die Sicherungen verloren. Alternativ SICHERUNG_PASSWORT_DATEI=<Pfad der Datei mit dem Passwort>.
#SICHERUNG_PASSWORT=
#SICHERUNG_UHRZEIT=03:00
#SICHERUNG_BEHALTEN=14
#SICHERUNG_KOPIE_VERZEICHNIS=/mnt/storagebox/hajime
#SICHERUNG_NACH_BEFEHL=rclone copy "$HAJIME_SICHERUNG_DATEI" speicher:hajime
#SICHERUNG_AUTOMATISCH=false
# Aufbewahrung des Fehlerprotokolls („Konsole“) in Tagen (Standard 30)
#FEHLER_AUFBEWAHRUNG_TAGE=30

# Betreiberangaben für Impressum und Datenschutzerklärung (/impressum.html, /datenschutz.html): Pfad der JSON-Datei (Vorlage: docs/datenschutz/rechtliches.example.json),
# Standard ./data/rechtliches.json. Fehlende Pflichtangaben erscheinen rot im Text und als Warnung in der Konsole. Im Docker-Container als Volume einbinden.
#RECHTLICHES_DATEI=/var/lib/hajime/rechtliches.json
# Konten ohne bestätigte E-Mail-Adresse werden nach so vielen Tagen gelöscht (Standard 30, steht so in der Datenschutzerklärung)
#UNBESTAETIGT_TAGE=30

# Installer und Updates (Seite „Downloads“, /api/releases/v1; Spec docs/specs/2026-10-24-downloads-ueber-cloud-design.md):
# Die Cloud spiegelt neue Releases stündlich aus dem PRIVATEN Repository (GitHub-Token nur mit Lesezugriff auf Inhalte, fine-grained).
# Ohne RELEASE_QUELLE_REPO ist die Spiegelung aus. Im Docker-Container die Ablage als Volume einbinden (docker-compose.yml: ./releases).
#RELEASE_QUELLE_REPO=oensel/Hajime-Pro
#RELEASE_QUELLE_TOKEN=
#RELEASE_VERZEICHNIS=/var/lib/hajime/releases
# So viele Versionen bleiben in der Ablage (Standard 3)
#RELEASE_BEHALTEN=3
