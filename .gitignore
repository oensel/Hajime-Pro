# Dependencies
node_modules/

# Secrets / lokale Konfiguration
.env
.env.*
!.env.cloud.example

# Laufzeitdaten (Datenbank-Dateien, enthält personenbezogene Turnier-/Judoka-Daten)
data/

# OS / Editor
.DS_Store
.idea/

# Playwright (E2E-Tests, siehe tests/e2e/)
/test-results/
/playwright-report/
