# Laufzeit-Statusdatei des Vollablauf-E2E-Tests (siehe tests/e2e-vollablauf/) — trackt während des
# Laufs erzeugte IDs in der echten Online-Cloud-DB für das Cleanup in global-teardown.js.
/tests/e2e-vollablauf/.run-state.json

# Heruntergeladene Turnier-Export-Dateien des Vollablauf-E2E-Tests — enthalten reale, aus der
# echten Cloud-DB exportierte Teilnehmerdaten (siehe exportiereTurnierDaten in helpers.js).
/tests/e2e-vollablauf/downloads/

# Claude Code lokale Einstellungen
.claude/settings.local.json

# Build-Ausgabe des Desktop-Clients (electron-builder, siehe desktop/electron-builder.yml)
/dist-desktop/
# Build-Ausgabe des Server-Pakets (desktop/electron-builder.server.yml)
/dist-server/

# Android-App (mobil/): generiertes Web-Verzeichnis, Capacitor-Abhängigkeiten, gebaute APKs
/mobil/www/
/mobil/node_modules/
/dist-android/

# Von der Release-Pipeline vor dem Build des Server-Pakets befüllt (Client-Dateien zum Mitliefern)
/client-dateien/*
!/client-dateien/.gitkeep
/android-schluessel/

# Playwright-Ausgaben (lokal erzeugt)
playwright-report/
test-results/
